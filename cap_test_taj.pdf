		        <script type="text/javascript">
            // <![CDATA[
            jQuery(document).ready(function($) {
                $('.date-author').each(function(i,el) {
                    var str = $(this).text();
                    var new_str = str.split("by")[0];
                    $(this).text(new_str);
                });
            });
            // ]]>
        </script>
