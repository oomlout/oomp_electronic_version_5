(footprint
  "mechanical_mounting_hole_4_mm_round_unplated"
  (version 20260206)
  (generator "kicad-footprint-generator")
  (layer "F.Cu")
  (descr "Mounting Hole 4mm, no annular, generated by kicad-footprint-generator mountinghole.py")
  (tags "mountinghole")
  (property "Reference" "REF**" (at 0 -4.95 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (property "Value" "mechanical_mounting_hole_4_mm_round_unplated" (at 0 4.95 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (property "KiLib_Generator" "mounting_hardware/mounting_hole" (at 0 0 0) (layer "F.SilkS") (hide yes) (effects (font (size 1 1) (thickness 0.15))))
  (attr exclude_from_pos_files exclude_from_bom)
  (duplicate_pad_numbers_are_jumpers no)
  (fp_circle (center 0 0) (end 4 0) (stroke (width 0.15) (type solid)) (fill no) (layer "Cmts.User"))
  (fp_circle (center 0 0) (end 4.25 0) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
  (fp_text user "${REFERENCE}" (at 0 0 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (pad "" np_thru_hole circle (at 0 0) (size 4 4) (drill 4) (layers "*.Cu" "*.Mask"))
  (embedded_fonts no)
  (fp_text user "TOZA" (at 0 -6.95) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
)
