<?xml version="1.0" encoding="UTF-8"?>
{% set d=p.label_drawer %}
<svg xmlns="http://www.w3.org/2000/svg" width="38.1mm" height="25.4mm" viewBox="0 0 38.1 25.4" role="img" aria-labelledby="title">
<title id="title">{{ d.type|e }} {{ d.primary|e }}; {{ d.package|e }}; {{ d.full_details|e }}; {{ d.bip39|e }}</title>
<desc>Electronic drawer label. Print at actual size. Details are read from current component source and manual overrides at regeneration.</desc>
<g transform="scale(1)" font-family="Arial Narrow, sans-serif" font-weight="700" fill="#000000">
<rect width="38.1" height="25.4" fill="#ffffff"/>
<rect x="0.8" y="0.8" width="36.5" height="4.3" rx="0.5"/>
<text id="component-type" x="1.8" y="3.95" font-size="{{ d.type_size }}" fill="#ffffff">{{ d.type|e }}</text>
<text id="package" x="36.3" y="3.9" text-anchor="end" font-size="{{ d.package_size }}" fill="#ffffff">{{ d.package|e }}</text>
{% for line in d.hero %}<text id="primary-{{ loop.index }}" x="1.8" y="{{ line.y }}" font-size="{{ line.size }}">{{ line.text|e }}</text>{% endfor %}
{% for line in d.rows %}<text id="detail-{{ loop.index }}" x="1.8" y="{{ line.y }}" font-size="{{ line.size }}">{{ line.text|e }}</text>{% endfor %}
<path d="M1.8 21.8H36.3" stroke="#000000" stroke-width="0.22"/>
<text id="bip39" x="1.8" y="24.2" font-size="{{ d.bip39_size }}">{{ d.bip39|e }}</text>
</g>
</svg>
