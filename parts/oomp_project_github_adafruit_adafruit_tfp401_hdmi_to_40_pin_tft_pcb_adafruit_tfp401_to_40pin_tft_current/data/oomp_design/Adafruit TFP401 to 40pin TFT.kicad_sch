e, With 12V source into a 3.3V LP2985 and a 30mA load, we are dissipating (12V-3.3V) * 0.03A = 0.261W.  With a θJA of 206 °C/W, a TJ of 150°C, and 261mW we can safely use the chip without a heat sink up to 75°C (=147.1°C Junction Temperature)." (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "ki_locked" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (symbol "VREG_SOT223_0_0" (polyline (pts (xy -5.08 5.08) (xy -5.08 -2.54)) (stroke (width 0.4064) (type solid)) (fill (type none))) (polyline (pts (xy -5.08 -2.54) (xy 5.08 -2.54)) (stroke (width 0.4064) (type solid)) (fill (type none))) (polyline (pts (xy 5.08 5.08) (xy -5.08 5.08)) (stroke (width 0.4064) (type solid)) (fill (type none))) (polyline (pts (xy 5.08 -2.54) (xy 5.08 5.08)) (stroke (width 0.4064) (type solid)) (fill (type none))) (text "IN" (at -4.445 1.905 0) (effects (font (size 1.524 1.2954)) (justify left bottom))) (text "GND" (at -2.032 -1.778 0) (effects (font (size 1.524 1.2954)) (justify left bottom))) (text "OUT" (at 0.635 1.905 0) (effects (font (size 1.524 1.2954)) (justify left bottom)))) (symbol "VREG_SOT223_1_0" (pin power_in line (at 0 -5.08 90) (length 2.54) (name "GND" (effects (font (size 0 0)))) (number "1" (effects (font (size 1.524 1.524))))) (pin power_in line (at 7.62 2.54 180) (length 2.54) (name "OUT" (effects (font (size 0 0)))) (number "2" (effects (font (size 0 0))))) (pin power_in line (at -7.62 2.54 0) (length 2.54) (name "IN" (effects (font (size 0 0)))) (number "3" (effects (font (size 1.524 1.524))))) (pin power_in line (at 7.62 2.54 180) (length 2.54) (name "OUT" (effects (font (size 0 0)))) (number "4" (effects (font (size 0 0)))))) (symbol "VREG_SOT223_1_1") (embedded_fonts no)) (symbol "kicad_file-eagle-import:XF2-40?-RARBT" (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (duplicate_pin_numbers_are_jumpers no) (property "Reference" "J" (at 2.54 -0.762 0) (sho