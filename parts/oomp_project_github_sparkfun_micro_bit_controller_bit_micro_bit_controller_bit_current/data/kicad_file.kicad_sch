	)
	(text "2.2K series resistors on signal lines to prevent excess\ncurrent draw if micro:bit pins are congifured as outputs,\nwritten to a logic high state, and the buttons are pressed.\nThis also means that logic \"low\" will be in the neighborhood of 0.5 V.\nThe nordic IC claims logic low threshold of 0.3 x Vcc,\napprox 1V for 3.3V supply."
		(exclude_from_sim no)
		(at 147.32 127 0)
		(effects
			(font
				(size 1.9304 1.9304)
			)
			(justify left bottom)
