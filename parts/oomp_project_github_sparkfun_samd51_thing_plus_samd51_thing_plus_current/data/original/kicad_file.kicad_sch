			(property "Description" "32.768kHz Crystal\n\n• Frequency: 32.768kHz\n• Frequency Stability: &plusmn;20ppm\n• Load Capacitance: 12.5pF (PTH-2X6 & SMD-3.2X1.5), 6pF (SMD-2X6)\n\nSparkFun Products:\n\n• SparkFun BigTime Watch Kit\n• SparkFun nRF52832 Breakout\n• SparkFun Real Time Clock Module"
				(at 0 0 0)
				(show_name no)
				(do_not_autoplace no)
