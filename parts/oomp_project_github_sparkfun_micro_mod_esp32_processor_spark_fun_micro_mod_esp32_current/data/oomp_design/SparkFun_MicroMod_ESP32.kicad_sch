er plating\n• red soldermask\n• white silkscreen\n\nTypes of information that should be added to box:\n\n• Special wash requirements\n• Depaneling instructions\n• Humidification\n• Glue curing\n\nDefault text settings:\n\n• 0.07 inch\n• 9% ratio\n• 50% line distance" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "ki_locked" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (symbol "SPECIAL_INSTRUCTIONS-ORDERING_0_0" (polyline (pts (xy 0 2.54) (xy 22.86 2.54)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 0 0) (xy 0 2.54)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 22.86 2.54) (xy 22.86 0)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 22.86 0) (xy 0 0)) (stroke (width 0.254) (type solid)) (fill (type none))) (text "Special Instructions" (at 1.27 0.6985 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)))) (symbol "SPECIAL_INSTRUCTIONS-ORDERING_1_1") (embedded_fonts no)) (symbol "kicad_file-eagle-import:TRANS_NPN_DUAL-MBT3904DW1T1" (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (duplicate_pin_numbers_are_jumpers no) (property "Reference" "Q" (at 2.54 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.778 1.778)) (justify left bottom))) (property "Value" "" (at 2.54 -2.286 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.778 1.778)) (justify left bottom))) (property "Footprint" "kicad_file:SC70-6" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Dual NPN Transistors in Single Package\n\nThe MBT3904W1 puts two general purpose 3904 NPN transistors in a single package.\n\nhttp://www.onsemi.com/pub_link/Collateral/MBT3904DW1T1-D.PDF Datash