	)
	(text "Power Supply"
		(exclude_from_sim no)
		(at 170.18 22.86 0)
		(effects
			(font
				(size 2.54 2.159)
			)
			(justify left bottom)
		)
		(uuid "437870ae-d581-4a71-98fc-e10f385b59ef")
	)
	(text "\" \""
		(exclude_from_sim no)
		(at 243.84 165.1 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "4eb18aaf-7d0b-45c0-bade-389e57e5c0c8")
	)
	(text "The OLED requires a 1.65-3.3V supply for its logic circuits (VDD) and a 7-7.5V\nsupply for it's display circuitry (VCC). Fortunately, it features a charge-pump\nboost converter to generate a 7V supply (VCC) from 3.3-4.2V. The\ncharge-pump input voltage is taken from the VBAT line.\nSJ3, closed by default, shorts the VDD and VBAT lines. This way the same supply\nyou're using to power the logic can be boosted for the VCC supply as well. In this\ncase, your VDD supply should be around 3.3V."
		(exclude_from_sim no)
		(at 170.18 25.4 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left top)
		)
		(uuid "4fd86e7e-268c-47bd-88ee-fc438c6f1289")
	)
	(text "Interface       BS1   BS2\n===================\nSPI                  0       0\nI2C                  1       0\n8-bit (6800)     0       1\n8-bit (8080)     1       1"
		(exclude_from_sim no)
		(at 172.72 119.38 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "5985904a-a59d-49dc-adaf-4b31d4ddb9b0")
	)
	(text "VCC current (Internally generated) = 5.8-20.9mA"
		(exclude_from_sim no)
		(at 215.9 76.2 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "76af728e-09f6-4d5e-8be8-9f90e588ca03")
	)
	(text "The SSD1306 can be controlled via SPI, I2C, or a parallel interface.\nUse the BS1 & BS2 jumpers to select the interface. The breakout\ndefaults to SPI (BS1 and BS2 connected to ground/0)."
		(exclude_from_sim no)
		(at 170.18 88.9 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left top)
		)
		(uuid "7da0ecc5-f69c-4006-beed-253c1cc64294")
	)
	(text "VDD current < 300 uA"
		(exclude_from_sim no)
		(at 215.9 73.66 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "8c0d7e75-2c47-4a93-b5f5-8fece60e3d47")
	)
	(text "Interface selection"
		(exclude_from_sim no)
		(at 170.18 86.36 0)
		(effects
			(font
				(size 2.54 2.159)
			)
			(justify left bottom)
		)
		(uuid "951a75f8-fe26-493b-8805-77f8bea3ab2e")
	)
	(text "1.65 <= VDD <= 3.3"
		(exclude_from_sim no)
		(at 219.456 49.784 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "9cad9c62-d9b3-40a1-9d72-742a45fcba2c")
	)
	(text "v04"
		(exclude_from_sim no)
		(at 259.334 196.596 0)
		(effects
			(font
				(size 3.81 3.2385)
			)
			(justify left bottom)
		)
		(uuid "9d6df474-c92d-4cf4-a4f5-35d41bf624ef")
	)
	(text "VCC (7.0-7.5V) will be generated by on-board DC-DC converter,\nas long as C3 and C2 are present. It's boosted up from VBAT."
		(exclude_from_sim no)
		(at 169.164 60.452 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left top)
		)
		(uuid "9f98e61a-0f2c-4ceb-bc3e-c97978eaf3be")
	)
	(text "In I2C mode, D/C sets the lower bit of the\n7-bit address. Short it one way or the other.\nD/C   I2C Address\n===========\n0           0x3C\n1           0x3D"
		(exclude_from_sim no)
		(at 223.52 165.1 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "a55485ab-e8db-4a43-a857-a5e57184898b")
	)
	(text "The D/C jumper should be open if\nSPI or parallel interfaces are used.\nIn those interfaces this pin determines\nwhether incoming signals are data or\ncommand."
		(exclude_from_sim no)
		(at 226.06 121.92 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "b39fc9d6-7a3e-4f62-bfe9-29a2ac06a5c2")
	)
	(text "3.3 <= VBAT <= 4.2"
		(exclude_from_sim no)
		(at 168.91 56.642 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "beda41fa-51b2-40b4-88c5-8f59c32a897b")
	)
	(text "Short D1 (SDAin) and D2 (SDAout)\nin I2C mode."
		(exclude_from_sim no)
		(at 170.18 157.48 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "e658568c-d1fc-4391-a177-f4758f9440f8")
	)
	(text "Jim Lindblom"
		(exclude_from_sim no)
		(at 185.42 194.31 0)
		(effects
			(font
				(size 3.81 3.2385)
			)
			(justify left bottom)
		)
		(uuid "f5d81a71-0212-417a-a7da-753f85109c8b")
	)
