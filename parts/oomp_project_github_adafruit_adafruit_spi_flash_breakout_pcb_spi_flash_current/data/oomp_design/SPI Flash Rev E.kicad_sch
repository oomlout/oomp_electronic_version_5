pads, no silkscreen outline, etc.):\n\n• _0402MP - Micro-pitch footprint for very dense/compact boards\n• _0603MP - Micro-pitch footprint for very dense/compact boards\n• _0805MP - Micro-pitch footprint for very dense/compact boards\n• _1206MP - Micro-pitch footprint for very dense/compact boards" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "ki_locked" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (symbol "RESISTOR_0603_NOOUT_0_0" (polyline (pts (xy -2.54 1.27) (xy 2.54 1.27)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy -2.54 -1.27) (xy -2.54 1.27)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 2.54 1.27) (xy 2.54 -1.27)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 2.54 -1.27) (xy -2.54 -1.27)) (stroke (width 0.254) (type solid)) (fill (type none)))) (symbol "RESISTOR_0603_NOOUT_1_0" (pin passive line (at -5.08 0 0) (length 2.54) (name "1" (effects (font (size 0 0)))) (number "1" (effects (font (size 0 0))))) (pin passive line (at 5.08 0 180) (length 2.54) (name "2" (effects (font (size 0 0)))) (number "2" (effects (font (size 0 0)))))) (symbol "RESISTOR_0603_NOOUT_1_1") (embedded_fonts no)) (symbol "kicad_file-eagle-import:SPIFLASH_8PIN208MIL" (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (duplicate_pin_numbers_are_jumpers no) (property "Reference" "U" (at -12.7 12.7 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.778 1.5113)) (justify left bottom))) (property "Value" "" (at -12.7 -10.16 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.778 1.5113)) (justify left bottom))) (property "Footprint" "kicad_file:SOIC8_208MIL" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "SOIC8 SPI Flash\n\nBe careful with the size since SOIC8 flash comes in several 'widths'\n\nSOIC8 150 mil\n\n• M25P16 - 16Mbit (2Mbit x 8) Serial Flash (75MHz SPI Bus), Supply: 2.7-3.6V Digikey:  SOIC8 - M25P16-VMN6P-ND\n\nSOIC8 208 mil\n\n• W25Q16BVSSIG - 16Mbit (2Mbit x 8) Serial Flash (104MHz SPI Bus), Supply: 2.7-3.6V Digikey:  SOIC8 - W25Q16BVSSIG-ND" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "ki_locked" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (symbol "SPIFLASH_8PIN208MIL_0_0" (polyline (pts (xy -12.7 10.16) (xy 12.7 10.16)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy -12.7 -7.62) (xy -12.7 10.16)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 12.7 10.16) (xy 12.7 -7.62)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 12.7 -7.62) (xy -12.7 -7.62)) (stroke (width 0.254) (type solid)) (fill (type none)))) (symbol "SPIFLASH_8PIN208MIL_1_0" (pin bidirectional line (at -15.24 0 0) (length 2.54) (name "SSEL" (effects (font (size 1.524 1.524)))) (number "1" (effects (font (size 1.524 1.524))))) (pin bidirectional line (at -15.24 2.54 0) (length 2.54) (name "MISO" (effects (font (size 1.524 1.524)))) (number "2" (effects (font (size 1.524 1.524))))) (pin bidirectional line (at -15.24 -2.54 0) (length 2.54) (name "WP#/IO2" (effects (font (size 1.524 1.524)))) (number "3" (effects (font (size 1.524 1.524))))) (pin bidirectional line (at 15.24 -5.08 180) (length 2.54) (name "VSS" (effects (font (size 1.524 1.524)))) (number "4" (effects (font (size 1.524 1.524))))) (pin bidirectional line (at -15.24 5.08 0) (length 2.54) (name "MOSI" (effects (font (size 1.524 1.524)))) (number "5" (effects (font (size 1.524 1.524))))) (pin bidirectional line (at -15.24 7.62 0) (length 2.54) (name "SCK" (effects (font (size 1.524 1.524)))) (number "6" (effects (font (siz