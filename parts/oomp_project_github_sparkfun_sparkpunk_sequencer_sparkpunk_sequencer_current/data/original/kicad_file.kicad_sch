	)
	(text "One step is selected at a time by the CD4017.\nThis turns on the transistor, lighting the step LED.\nThe slide pot and switch place the voltage on the\nPOTSUM and GATESUM busses, respectively,\neach combined using a diode-or circuit."
		(exclude_from_sim no)
		(at 233.68 109.22 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "e99f2992-8b45-4f01-997f-d7d17fb7a817")
	)
