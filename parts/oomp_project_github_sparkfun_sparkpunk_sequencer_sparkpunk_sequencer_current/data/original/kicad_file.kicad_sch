	(text "IC4G1 buffers the gate switch output.\nIC4G2 adds scaled versions of the 50% step clock and running signal.  The result is a stair-step waveform\nof clock superimposed on gate.\nIC2G2 is a comparator that trips when the stair-step waveform crosses a threshold.  The threshold can be set for\nlong or short steps.\nSee the SPICE sims for more detailed waveforms."
		(exclude_from_sim no)
		(at 276.86 210.82 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "9ecfc6f6-de4a-4924-93b0-b4dd7439820a")
	)
	(text "IC3G1 scales and buffers the voltage from the slider wipers - scaled to a range that\ndoesn't clip the opamp by getting too close to the 9V rail.\nRV2 and C3 form an adjustable lowpass on the resulting voltage, buffered by IC3G2.\nIC2G1 inverts, shifts and scales that to a range suitable to drive 555's.\nA 555's CV range is centered between the rails, and has an inverse\nvoltage-to-frequency response."
		(exclude_from_sim no)
		(at 127 195.58 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "aeeedb5d-0446-4f93-8587-fe29cd7827b8")
	)
	(text "Control Voltage summing & glide circuit"
		(exclude_from_sim no)
		(at 127 194.564 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "b7336ed0-9832-4dfe-960b-d4bc5a9cc2c8")
	)
	(text "PLAY"
		(exclude_from_sim no)
		(at 38.1 35.56 0)
		(effects
