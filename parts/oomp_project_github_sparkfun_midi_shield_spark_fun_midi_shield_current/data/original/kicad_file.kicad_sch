	(text "MIDI I/O reference design from:\nhttp://www.midi.org/techspecs/electrispec.php\nSJ4, SJ5, SJ6, SJ7 implement power-over-MIDI,\nusing pin assignment\nproposed by Craig Anderton\n(Pin 1 = Vcc, pin 3 = ground).\nClose JP4 & 5 to power the MIDI input.\nClose JP6 & 7 to power the output."
		(exclude_from_sim no)
		(at 27.94 177.8 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left top)
		)
		(uuid "10af8987-efae-46b4-ac79-dbf190112a84")
	)
