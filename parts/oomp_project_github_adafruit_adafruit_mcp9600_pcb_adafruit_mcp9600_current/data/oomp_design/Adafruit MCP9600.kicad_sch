e/compact boards\n• _0603MP - Micro-pitch footprint for very dense/compact boards\n• _0805MP - Micro-pitch footprint for very dense/compact boards\n• _1206MP - Micro-pitch footprint for very dense/compact boards" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "ki_locked" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (symbol "RESISTOR_0603_NOOUT_0_0" (polyline (pts (xy -2.54 1.27) (xy 2.54 1.27)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy -2.54 -1.27) (xy -2.54 1.27)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 2.54 1.27) (xy 2.54 -1.27)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 2.54 -1.27) (xy -2.54 -1.27)) (stroke (width 0.254) (type solid)) (fill (type none)))) (symbol "RESISTOR_0603_NOOUT_1_0" (pin passive line (at -5.08 0 0) (length 2.54) (name "1" (effects (font (size 0 0)))) (number "1" (effects (font (size 0 0))))) (pin passive line (at 5.08 0 180) (length 2.54) (name "2" (effects (font (size 0 0)))) (number "2" (effects (font (size 0 0)))))) (symbol "RESISTOR_0603_NOOUT_1_1") (embedded_fonts no)) (symbol "kicad_file-eagle-import:SOLDERJUMPER" (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (duplicate_pin_numbers_are_jumpers no) (property "Reference" "SJ" (at -2.54 2.54 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.0795)) (justify left bottom))) (property "Value" "" (at -2.54 -3.81 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.0795)) (justify left bottom))) (property "Footprint" "kicad_file:SOLDERJUMPER_ARROW_NOPASTE" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "SMD Solder JUMPER\n\nSolder the two pads together to create a connection, or remove the solder to break it.\n\nREFLOW - Use this footprint for solder paste and reflow ovens. WAVE - Use this footprint for hand-soldering (larger pads).\n\nCLOSED - Has a trace between the two pads to ensure it is closed by default.  The trace needs to be cut to disable the jumper, and can be closed again by creating a solder bridge between the two pads." (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "BOM" "EXCLUDE" (at 0 -5.334 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "ki_locked" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (symbol "SOLDERJUMPER_0_0" (polyline (pts (xy -2.54 0) (xy -1.651 0)) (stroke (width 0.1524) (type solid)) (fill (type none))) (arc (start -0.381 -0.635) (mid -1.0159 0.0001) (end -0.3808 0.635) (stroke (width 1.27) (type solid)) (fill (type none))) (arc (start 0.381 0.635) (mid 1.0159 -0.0001) (end 0.3808 -0.635) (stroke (width 1.27) (type solid)) (fill (type none))) (polyline (pts (xy 2.54 0) (xy 1.651 0)) (stroke (width 0.1524) (type solid)) (fill (type none)))) (symbol "SOLDERJUMPER_1_0" (pin passive line (at -5.08 0 0) (length 2.54) (name "1" (effects (font (size 0 0)))) (number "1" (effects (font (size 1.524 1.524))))) (pin passive line (at 5.08 0 180) (length 2.54) (name "2" (effects (font (size 0 0)))) (number "2" (effects (font (size 1.524 1.524)))))) (symbol "SOLDERJUMPER_1_1") (embedded_fonts no)) (symbol "kicad_file-eagle-import:TERMBLOCK_1X2_3.5MM" (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (duplicate_pin_numbers_are_jumpers no) (property "Reference" "X" (at -2.54 7.62 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.0795)) (justify left bottom))) (property "Value" "" (at -2.54 -5.08 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.0795)) (justify left bottom))) (property "Footprint" "kicad_f