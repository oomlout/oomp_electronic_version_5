	(text "MIDI-OUT-PIN2"
		(exclude_from_sim no)
		(at 393.954 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a0e07aeb-5d66-48ba-9f75-70cb06734d99")
	)
	(text "MIDI inputs are not grounded.  MIDI\noutputs are, with the shield of the\ncable tied to Pin 2 of the DIN.\nDIN-5 connectors have an odd\npin-ordering -- pin 2 is between\n4 and 5, as reflected in the\nconnector above."
		(exclude_from_sim no)
		(at 358.14 231.14 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "af55b2a8-da7e-47f1-84ec-4fb6645386f2")
	)
