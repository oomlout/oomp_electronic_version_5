			)
			(justify left bottom)
		)
		(uuid "c86e7d32-25c3-4bb3-90a9-5e2b9e7a4919")
	)
	(text "MIDI signals can be wired to standard\n5-pin DIN connectors.  Not all 5 pins are\nconnected.  Connect the pads below to the\npins indicated."
		(exclude_from_sim no)
		(at 358.14 182.88 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "d2026340-f641-44f3-837e-331c8537cda6")
	)
	(text "High Pass: 4.8Hz (33K/1.0uF)\nLow Pass: 48.3KHz (33K/100pF)\nSlew Rate: 1V/uS (1,000,000V/sec)\nMax Freq (at 3.3V power):\nslew rate (V/sec) = 2*pi*f*V\n1,000,000 = 2(3.14)f(3.3V)\nf(max) = 48KHz"
		(exclude_from_sim no)
		(at 135.128 205.486 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "ee06ae26-62af-4395-95c7-82af2b00d338")
	)
