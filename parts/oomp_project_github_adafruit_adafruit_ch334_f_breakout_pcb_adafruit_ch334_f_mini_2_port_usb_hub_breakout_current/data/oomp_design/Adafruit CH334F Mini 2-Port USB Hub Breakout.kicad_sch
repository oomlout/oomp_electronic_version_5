otprints can be used (smaller pads, no silkscreen outline, etc.):\n\n• _0402MP - Micro-pitch footprint for very dense/compact boards\n• _0603MP - Micro-pitch footprint for very dense/compact boards\n• _0805MP - Micro-pitch footprint for very dense/compact boards\n• _1206MP - Micro-pitch footprint for very dense/compact boards" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "ki_locked" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (symbol "RESISTOR_0603_NOOUT_0_0" (polyline (pts (xy -2.54 1.27) (xy 2.54 1.27)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy -2.54 -1.27) (xy -2.54 1.27)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 2.54 1.27) (xy 2.54 -1.27)) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 2.54 -1.27) (xy -2.54 -1.27)) (stroke (width 0.254) (type solid)) (fill (type none)))) (symbol "RESISTOR_0603_NOOUT_1_0" (pin passive line (at -5.08 0 0) (length 2.54) (name "1" (effects (font (size 0 0)))) (number "1" (effects (font (size 0 0))))) (pin passive line (at 5.08 0 180) (length 2.54) (name "2" (effects (font (size 0 0)))) (number "2" (effects (font (size 0 0)))))) (symbol "RESISTOR_0603_NOOUT_1_1") (embedded_fonts no)) (symbol "kicad_file-eagle-import:SOLDERJUMPER_CLOSED" (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (duplicate_pin_numbers_are_jumpers no) (property "Reference" "SJ" (at -2.54 2.54 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.778 1.5113)) (justify left bottom))) (property "Value" "" (at -2.54 -3.81 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.778 1.5113)) (justify left bottom))) (property "Footprint" "kicad_file:SOLDERJUMPER_CLOSEDWIRE" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (hi