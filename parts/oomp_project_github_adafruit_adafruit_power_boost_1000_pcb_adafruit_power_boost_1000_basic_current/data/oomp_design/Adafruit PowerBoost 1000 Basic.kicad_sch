35 Lightning Sensor)\n\nVishay IHLP\n\n• 1.0uH Molded Inductor - 24mOhm DCR, 5A, +/-20%, -55°C-125°C (Digikey: 541-1319-1-ND)" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "ki_locked" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (symbol "INDUCTOR-8X8_0_0" (polyline (pts (xy -2.54 0.3175) (xy -2.54 0)) (stroke (width 0.254) (type solid)) (fill (type none))) (arc (start -2.54 0.3175) (mid -1.9049 0.9524) (end -1.27 0.3173) (stroke (width 0.254) (type solid)) (fill (type none))) (arc (start -1.27 0.3175) (mid -0.6349 0.9524) (end 0 0.3173) (stroke (width 0.254) (type solid)) (fill (type none))) (arc (start 0 0.3175) (mid 0.6351 0.9524) (end 1.27 0.3173) (stroke (width 0.254) (type solid)) (fill (type none))) (arc (start 1.27 0.3175) (mid 1.9051 0.9524) (end 2.54 0.3173) (stroke (width 0.254) (type solid)) (fill (type none))) (polyline (pts (xy 2.54 0.3175) (xy 2.54 0)) (stroke (width 0.254) (type solid)) (fill (type none)))) (symbol "INDUCTOR-8X8_1_0" (pin passive line (at -5.08 0 0) (length 2.54) (name "1" (effects (font (size 0 0)))) (number "P$1" (effects (font (size 0 0))))) (pin passive line (at 5.08 0 180) (length 2.54) (name "2" (effects (font (size 0 0)))) (number "P$2" (effects (font (size 0 0)))))) (symbol "INDUCTOR-8X8_1_1") (embedded_fonts no)) (symbol "kicad_file-eagle-import:LED0805_NOOUTLINE" (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (duplicate_pin_numbers_are_jumpers no) (property "Reference" "D" (at -1.27 4.445 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.0795)))) (property "Value" "" (at -1.27 -2.794 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.0795)))) (property "Footprint" "kicad_file:CHIPLED_0805_NOOUTLINE" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide y