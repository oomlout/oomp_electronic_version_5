		(uuid "9ad79e9a-03fa-4515-840b-cfa357b34bd6")
	)
	(text "JP1 and JP6 break out all four component pins.\nThe two headers are breadboard compatible.\nIf multiple switches are connected in a matrix,\nthe SWITCH2 and LED cathod pins can be\ninterconnected to form the ROWS of a matrix."
		(exclude_from_sim no)
		(at 43.18 86.36 0)
